# Porta HTTP do painel
PORT=3000

# String de conexão do Postgres (Railway/Render fornecem automaticamente em produção)
DATABASE_URL=postgres://usuario:senha@host:5432/banco

# Segredo para assinar o cookie de sessão do login (gere uma string aleatória longa)
SESSION_SECRET=troque-por-uma-string-aleatoria-longa

# Login único do gestor
ADMIN_USER=lucas
ADMIN_PASS=escolha-uma-senha-forte

# Diretórios persistentes (em produção, aponte para um volume persistente, ex: /data/auth e /data/media)
AUTH_DIR=./storage/auth
MEDIA_DIR=./storage/media
